{
  "name": "hermes-studio-desktop",
  "version": "0.1.0",
  "description": "Hermes Studio desktop client with OpenDots interface",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "npm run typecheck:renderer && vite build upstream --config upstream/vite.config.ts && npm run build:metadata",
    "start": "electron .",
    "package:dir": "npm run build && npm run verify:package && electron-builder --dir --mac --arm64 --config electron-builder.config.cjs",
    "package:dmg": "npm run build && npm run verify:package && electron-builder --mac dmg --arm64 --config electron-builder.config.cjs",
    "typecheck": "npm run typecheck:renderer && npm run typecheck:metadata",
    "test:upstream": "vitest run --root upstream",
    "test": "npm run typecheck && node --test hermes/*.test.mjs && npm run test:metadata && npm run test:bootstrap && npm run test:external-links",
    "test:metadata": "vitest run --root upstream tests/pages.test.ts tests/page-routes.test.ts tests/workspace.test.ts tests/store.test.ts tests/autosave.test.ts tests/app.test.ts tests/voice.test.ts tests/page-snapshots.test.ts src/client/hermes-display.test.ts src/client/manual-space-review.test.ts",
    "verify:package": "node scripts/verify-package.cjs",
    "test:bootstrap": "node scripts/test-bootstrap.cjs",
    "typecheck:upstream": "tsc --noEmit -p upstream/tsconfig.json",
    "typecheck:renderer": "tsc --noEmit -p tsconfig.renderer.json",
    "typecheck:metadata": "tsc --noEmit -p tsconfig.metadata.json",
    "build:metadata": "tsc -p tsconfig.metadata.json && node scripts/metadata-manifest.cjs",
    "test:external-links": "node scripts/test-external-links.cjs",
    "test:packaged-ui": "node scripts/test-packaged-ui.cjs",
    "test:packaged-connections": "node scripts/test-packaged-connections.cjs"
  },
  "keywords": [],
  "author": "Atai Barkai",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "@modelcontextprotocol/sdk": "1.31.0",
    "hono": "4.13.11",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "4.1.11",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "@ag-ui/client": "0.0.59",
    "@ag-ui/core": "0.0.59",
    "@copilotkit/channels": "0.11.0",
    "@copilotkit/core": "1.75.0",
    "@copilotkit/react-core": "1.75.0",
    "@copilotkit/runtime": "1.75.0",
    "@tanstack/ai": "0.63.0",
    "@tanstack/ai-openai": "0.25.1",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-placeholder": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/extension-task-item": "3.31.3",
    "@tiptap/extension-task-list": "3.31.3",
    "@tiptap/markdown": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@tiptap/suggestion": "3.31.3",
    "lucide-react": "1.48.0",
    "playwright": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "rxjs": "7.8.1",
    "ssh2": "1.17.0"
  },
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CopilotKit/OpenDots.git"
  },
  "overrides": {
    "undici": "^6.29.0",
    "@tanstack/openai-base": "0.12.1",
    "@tiptap/extension-bubble-menu": "3.31.3",
    "@tiptap/extension-floating-menu": "3.31.3"
  },
  "build": {
    "appId": "com.cookkie03.hermes-studio",
    "productName": "Hermes Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "hermes/**",
      "upstream/dist/**",
      "package.json",
      "upstream/LICENSE",
      "upstream/PROVENANCE.md",
      "README.md"
    ],
    "asar": true,
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "identity": null
    },
    "dmg": {
      "title": "Hermes Studio",
      "contents": [
        {
          "x": 150,
          "y": 160
        },
        {
          "x": 450,
          "y": 160,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "asarUnpack": [
      "hermes/**",
      "upstream/dist/server/**"
    ]
  }
}
